# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets — credentials are environment-only (see .env.example);
# these must never be committed. Config files are safe to commit because
# config.load_config() refuses credential-like fields.
.env
.env.*
!.env.example

# Run output — regenerated by every run, never source of truth
output/*
!output/.gitkeep

# Local run configs — your own brand, keywords, and competitors. The repo
# ships only generic templates (config/example.yaml, config/themes.yaml);
# copy one to *.local.yaml and it stays out of git. The pattern is
# deliberately brand-neutral so nothing here names a company.
config/*.local.yaml

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Packaged deliverable — rebuild via zip, don't commit the archive itself
*.zip
