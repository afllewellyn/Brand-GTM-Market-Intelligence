# All credentials live in environment variables ONLY.
# Config files never contain keys, so they are always safe to share/commit.
# (.env is gitignored; the config loader rejects credential-like fields.)

# Anthropic API key (required for live LLM analysis; demo mode works without it)
ANTHROPIC_API_KEY=

# DataForSEO — primary production search provider (search.provider: dataforseo)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Serper — supported alternative search provider (search.provider: serper)
SERPER_API_KEY=
